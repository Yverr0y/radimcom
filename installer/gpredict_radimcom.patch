+/* RADIMCOM: radio and rotor on this PC. Existing files are never changed. */
+static void radimcom_hwconf_file(const gchar *confdir, const gchar *name,
+                                 const gchar *contents)
+{
+    gchar *fname = g_build_filename(confdir, name, NULL);
+
+    if (!g_file_test(fname, G_FILE_TEST_EXISTS))
+    {
+        if (g_file_set_contents(fname, contents, -1, NULL))
+            sat_log_log(SAT_LOG_LEVEL_INFO, _("%s: Created %s"), __func__,
+                        fname);
+        else
+            sat_log_log(SAT_LOG_LEVEL_ERROR, _("%s: Failed to create %s"),
+                        __func__, fname);
+    }
+    g_free(fname);
+}
