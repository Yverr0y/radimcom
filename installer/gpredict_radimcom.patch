+/* RADIMCOM: send a noted command, until a server refuses it. */
+static void send_label(GtkRotCtrl *ctrl, gchar **label, gboolean *refused)
+{
+    gchar *msg;
+    gchar buffback[128];
+
+    g_mutex_lock(&ctrl->client.mutex);
+    msg = *label;
+    *label = NULL;
+    g_mutex_unlock(&ctrl->client.mutex);
+
+    if (msg == NULL)
+        return;
+
+    if (!*refused && rotctld_socket_rw(ctrl->client.socket, msg, buffback, 127))
+        *refused = strncmp(buffback, "RPRT 0", 6) != 0;
+
+    g_free(msg);
+}
