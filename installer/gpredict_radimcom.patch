 /* Communication thread for hamlib rigctld */
+/* RADIMCOM: send the transponder name when it changed or the link is new. */
+static void send_trsp_label(GtkRigCtrl *ctrl)
+{
+    gchar *msg = NULL;
+    gchar buffback[128];
+
+    g_mutex_lock(&ctrl->trsp_label_lock);
+    if (ctrl->trsp_label_dirty)
+    {
+        msg = g_strdup_printf("\\set_trsp %s\x0a",
+                              ctrl->trsp_label ? ctrl->trsp_label : "");
+        ctrl->trsp_label_dirty = FALSE;
+    }
+    g_mutex_unlock(&ctrl->trsp_label_lock);
+
+    if (msg != NULL)
+    {
+        /* the answer does not matter: other radio servers refuse it */
+        send_rigctld_command(ctrl, ctrl->sock, msg, buffback, sizeof(buffback));
+        g_free(msg);
+    }
+}
+
+/* RADIMCOM: send the time to AOS/LOS, until a server refuses the command. */
+static void send_pass_label(GtkRigCtrl *ctrl)
+{
+    gchar *msg;
+    gchar buffback[128];
+
+    g_mutex_lock(&ctrl->trsp_label_lock);
+    msg = ctrl->pass_label;
+    ctrl->pass_label = NULL;
+    g_mutex_unlock(&ctrl->trsp_label_lock);
+
+    if (msg == NULL)
+        return;
+
+    if (!ctrl->pass_refused &&
+        send_rigctld_command(ctrl, ctrl->sock, msg, buffback, sizeof(buffback)))
+        ctrl->pass_refused = strncmp(buffback, "RPRT 0", 6) != 0;
+
+    g_free(msg);
+}
